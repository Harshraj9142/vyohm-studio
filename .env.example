# Copy this file to .env.local and put your real key there.
# .env.local is git-ignored, so your key never goes into the repository.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model to use (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: how hard Claude thinks (low | medium | high). Lower = faster.
# Default: medium for generating pages.
# ANTHROPIC_EFFORT=medium
